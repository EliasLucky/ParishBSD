#!/bin/sh
# livecd-rc  minimal rc for the live environment.
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH

/usr/sbin/devd -q

IF=$(ifconfig -l | awk '{print $1}')
[ -n "$IF" ] && dhclient "$IF" >/dev/null 2>&1 || true

# Live user is in wheel with NOPASSWD sudo.
mkdir -p /usr/local/etc/sudoers.d
cat > /usr/local/etc/sudoers.d/live <<'EOF'
live ALL=(ALL) NOPASSWD: ALL
EOF
chmod 0440 /usr/local/etc/sudoers.d/live
chown root:wheel /usr/local/etc/sudoers.d/live

# LightDM autologin config.
mkdir -p /usr/local/etc/lightdm
cat > /usr/local/etc/lightdm/lightdm.conf <<'EOF'
[Seat:*]
autologin-user=live
autologin-user-timeout=0
user-session=xfce
greeter-session=lightdm-gtk-greeter
EOF

if [ -x /usr/local/bin/lightdm ]; then
    msg="starting graphical environment"
    echo "[parishbsd-init] $msg"
    if /usr/local/bin/lightdm; then
        exit 0
    fi
    echo "[parishbsd-init] lightdm failed; falling back to console"
fi

# Fallback: console with bsdinstall available.
cat <<'EOF'

  ParishBSD live console.
  Type 'bsdinstall' to install to disk.
  Type 'reboot' to reboot.

EOF
exec /usr/bin/login -f root