/* ParishBSD Calamares stylesheet — hand-authored, driven by Aerobird.
 *
 * Generated by scripts/generate-calamares-qss.py from:
 *   - widgets/colors.css         (semantic palette)
 *   - widgets/colors-themed.css  (aero palette)
 *
 * @@name@@ placeholders are replaced with hex values extracted from
 * the installed theme's gtk.css. If Aerobird does not define a name,
 * the generator's DEFAULTS table is used.
 *
 * Button gradients are hardcoded because Aerobird hardcodes them too;
 * they are not derived from @define-color values.
 */

/* ---- top-level window ------------------------------------------- */

#mainApp {
    background: @@theme_bg_color@@;
    color: @@theme_fg_color@@;
}

QLabel {
    color: @@theme_fg_color@@;
}

QWidget {
    font-family: "DejaVu Sans", "Noto Sans", sans-serif;
    font-size: 10pt;
}

/* ---- sidebar (Calamares-specific object name) ------------------- */
/* Background matches the Aerobird headerbar so the installer feels
 * like the same window class as any XFCE app on this system. */

#sidebarApp {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0    @@aero_dark@@,
                                stop:0.50 @@aero_base@@,
                                stop:0.51 @@aero_base@@,
                                stop:0.97 @@aero_mid@@,
                                stop:1.00 @@aero_light@@);
    border-right: 1px solid @@aero_outline@@;
}

#sidebarMenuApp,
#sidebarMenuApp QLabel {
    background: transparent;
    color: #ffffff;
}

#sidebarMenuApp QLabel:disabled {
    color: @@aero_base_i@@;
}

/* ---- buttons ---------------------------------------------------- */
/* Mirrors the Aerobird button gradients from gtk.css:
 *   default: #f7f7f7 -> #ebebeb 50% -> #dddddd 51% -> #d4d4d4
 *   hover:   #eaf6fd -> #d9f0fc 50% -> #bee6fd 51% -> #a7d9f5
 *   active:  #e5f4fc -> #c4e5f6 50% -> #98d1ef 51% -> #68b3db
 */

QPushButton {
    min-height: 24px;
    min-width: 80px;
    padding: 2px 6px;
    border: 1px solid @@borders@@;
    border-radius: 3px;
    color: @@theme_fg_color@@;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0.00 #f7f7f7,
                                stop:0.50 #ebebeb,
                                stop:0.51 #dddddd,
                                stop:1.00 #d4d4d4);
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0.00 #eaf6fd,
                                stop:0.50 #d9f0fc,
                                stop:0.51 #bee6fd,
                                stop:1.00 #a7d9f5);
}

QPushButton:pressed,
QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0.00 #e5f4fc,
                                stop:0.50 #c4e5f6,
                                stop:0.51 #98d1ef,
                                stop:1.00 #68b3db);
    border-color: #2c628b;
}

QPushButton:disabled {
    background: @@insensitive_bg_color@@;
    border-color: @@borders@@;
    color: @@insensitive_fg_color@@;
}

/* ---- text inputs ------------------------------------------------ */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QComboBox {
    min-height: 24px;
    padding: 3px 8px;
    background: @@theme_base_color@@;
    color: @@theme_text_color@@;
    border: 1px solid @@borders@@;
    border-radius: 3px;
    selection-background-color: @@theme_selected_bg_color@@;
    selection-color: @@theme_selected_fg_color@@;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 1px solid @@theme_selected_bg_color@@;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    background: @@insensitive_bg_color@@;
    color: @@insensitive_fg_color@@;
}

/* ---- combobox dropdown ----------------------------------------- */

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: @@theme_base_color@@;
    border: 1px solid @@borders@@;
    selection-background-color: @@theme_selected_bg_color@@;
    selection-color: @@theme_selected_fg_color@@;
}

/* ---- progress bar ----------------------------------------------- */
/* Matches Aerobird's trough gradient and green progress. */

QProgressBar {
    min-height: 20px;
    border: 1px solid @@borders@@;
    border-radius: 2px;
    text-align: center;
    color: @@theme_fg_color@@;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0.00 #ced2dc,
                                stop:1.00 #e0e4ed);
}

QProgressBar::chunk {
    border-radius: 1px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0.00 #11bf2a,
                                stop:0.50 #02d42b,
                                stop:1.00 #11bf2a);
}

/* ---- lists and tables ------------------------------------------- */

QListView,
QTreeView,
QTableView {
    background: @@theme_base_color@@;
    alternate-background-color: @@theme_unfocused_bg_color@@;
    border: 1px solid @@borders@@;
    selection-background-color: @@theme_selected_bg_color@@;
    selection-color: @@theme_selected_fg_color@@;
}

QHeaderView::section {
    background: @@theme_bg_color@@;
    border: 1px solid @@borders@@;
    padding: 4px 6px;
    color: @@theme_fg_color@@;
}

/* ---- scrollbars ------------------------------------------------- */

QScrollBar:vertical {
    background: #e9e9e9;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0.00 #f4f4f4,
                                stop:0.45 #e9e9eb,
                                stop:0.46 #d9dadc,
                                stop:1.00 #c0c0c4);
    border: 1px solid @@borders@@;
    border-radius: 2px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0.00 #e3f4fc,
                                stop:0.45 #d6eefb,
                                stop:0.46 #a9dbf6,
                                stop:1.00 #a4d5ef);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* ---- warnings and errors ---------------------------------------- */

QLabel[error="true"],
QLabel#errorLabel {
    color: @@error_color@@;
}

QLabel[warning="true"],
QLabel#warningLabel {
    color: @@warning_color@@;
}