#!/bin/sh
# PROVIDE: parishbsd_vault_idle
# REQUIRE: LOGIN parishbsd_vaults
# KEYWORD: shutdown

. /etc/rc.subr

name="parishbsd_vault_idle"
rcvar="${name}_enable"
pidfile="/var/run/${name}.pid"
procname="/usr/local/parishbsd/scripts/vault-idle-lockd.sh"

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

: ${parishbsd_vault_idle_enable:="NO"}

parishbsd_vault_idle_start()
{
	echo "Starting ${name}."
	/usr/sbin/daemon -f -p "$pidfile" -o /var/log/parishbsd-vault-idle-daemon.log \
		/bin/sh "$procname"
}

parishbsd_vault_idle_stop()
{
	if [ -f "$pidfile" ]; then
		kill "$(cat "$pidfile")" 2>/dev/null || true
		rm -f "$pidfile"
	fi
}

parishbsd_vault_idle_status()
{
	if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
		echo "${name} is running as pid $(cat "$pidfile")."
	else
		echo "${name} is not running."
		return 1
	fi
}

load_rc_config "$name"
run_rc_command "$1"
