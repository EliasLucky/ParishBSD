#!/bin/sh
# parish-usb  attach/detach/list removable media.

set -eu

err() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
log() { printf '    %s\n' "$*"; }

require_root() {
    [ "$(id -u)" -eq 0 ] || err "this subcommand requires root"
}

cmd_list() {
    for dev in /dev/da[0-9] /dev/cd[0-9]; do
        [ -b "$dev" ] || continue
        base="$(basename "$dev")"
        fstype="$(fstyp "$dev" 2>/dev/null || echo unknown)"
        size="$(diskinfo -v "$dev" 2>/dev/null | awk '/mediasize in bytes/{printf "%.1f GB", $1/1024/1024/1024; exit}')"
        printf '%-8s %-12s %s\n' "$base" "$fstype" "${size:-unknown}"
    done
}

cmd_attach() {
    require_root
    jail="${1:?usage: parish-usb attach <jail> <device>}"
    dev="${2:?}"
    [ -b "/dev/$dev" ] || err "not a block device: /dev/$dev"

    jail_root="/usr/local/jails/app/$jail"
    [ -d "$jail_root" ] || err "no such jail: $jail"

    host_mnt="/var/parishbsd/media/$dev"
    jail_mnt="$jail_root/media/$dev"
    mkdir -p "$host_mnt" "$jail_mnt"

    fstype="$(fstyp "/dev/$dev" 2>/dev/null || echo unknown)"
    case "$fstype" in
        msdosfs) mount -t msdosfs -o ro "/dev/$dev" "$host_mnt" ;;
        ufs)     mount -t ufs -o ro "/dev/$dev" "$host_mnt" ;;
        cd9660)  mount -t cd9660 -o ro "/dev/$dev" "$host_mnt" ;;
        exfat)   mount -t exfat -o ro "/dev/$dev" "$host_mnt" ;;
        ntfs)    mount -t ntfs -o ro "/dev/$dev" "$host_mnt" ;;
        *) err "unsupported filesystem: $fstype" ;;
    esac

    mount_nullfs "$host_mnt" "$jail_mnt"
    log "attached /dev/$dev to '$jail' at /media/$dev (read-only)"
}

cmd_detach() {
    require_root
    jail="${1:?usage: parish-usb detach <jail> <device>}"
    dev="${2:?}"
    host_mnt="/var/parishbsd/media/$dev"
    jail_mnt="/usr/local/jails/app/$jail/media/$dev"
    umount "$jail_mnt" 2>/dev/null || true
    umount "$host_mnt" 2>/dev/null || true
    rmdir "$jail_mnt" 2>/dev/null || true
    log "detached /dev/$dev from '$jail'"
}

cmd="${1:-}"; shift || true
case "$cmd" in
    list)    cmd_list ;;
    attach)  cmd_attach "$@" ;;
    detach)  cmd_detach "$@" ;;
    *)       err "usage: parish-usb {list|attach|detach} ..." ;;
esac