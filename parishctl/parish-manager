#!/bin/sh
# parish-manager graphical container manager for ParishBSD.
#
# A yad-based GUI that wraps parishctl, parish-install-custom, and
# parish-attach-device. It contains no logic of its own. every action
# is a call to one of those tools.
#
# Usage:
#   parish-manager          Launch the GUI
#
# Environment:
#   PARISHBSD_ROOT   repo root (default /usr/local/parishbsd)
set -eu

PARISHBSD_ROOT="${PARISHBSD_ROOT:-/usr/local/parishbsd}"
PARISHCTL="$PARISHBSD_ROOT/parishctl/parishctl"
INSTALL_CUSTOM="$PARISHBSD_ROOT/parishctl/parish-install-custom"
ATTACH_DEVICE="$PARISHBSD_ROOT/parishctl/parish-attach-device"
VAULT_FILES="$PARISHBSD_ROOT/parishctl/parish-vault-files"
CATALOG="$PARISHBSD_ROOT/catalog/applications.catalog"
LOGO="/usr/local/share/pixmaps/parishbsd.png"

err() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

command -v yad >/dev/null 2>&1 || err "yad not installed"
[ -x "$PARISHCTL" ] || err "parishctl not found at $PARISHCTL"

# =====================================================================
# Data gathering
# =====================================================================

# get_containers - emit "name|kind|state" (one per line, pipe-separated).
get_containers() {
    "$PARISHCTL" list 2>/dev/null \
        | sed 's/\x1b\[[0-9;]*m//g' \
        | awk 'NR > 1 && NF >= 3 {print $1 "|" $2 "|" $3}'
}

is_running() {
    jls name 2>/dev/null | grep -qx "$1"
}

is_vault() {
    name="$1"
    for tier in app vault; do
        meta="/usr/local/jails/$tier/$name/usr/local/etc/parishbsd/metadata"
        [ -f "$meta" ] || continue
        grep -q '^PERSONALITY=vault-' "$meta" 2>/dev/null && return 0
    done
    return 1
}

is_compatibility_jail() {
    name="$1"
    for tier in app vault; do
        meta="/usr/local/jails/$tier/$name/usr/local/etc/parishbsd/metadata"
        [ -f "$meta" ] || continue
        grep -qE '^PERSONALITY=(apps?-compatible)' "$meta" 2>/dev/null && return 0
    done
    return 1
}

# kind_of - return the display kind for a container.
kind_of() {
    name="$1"
    for tier in app vault; do
        meta="/usr/local/jails/$tier/$name/usr/local/etc/parishbsd/metadata"
        [ -f "$meta" ] || continue
        p="$(grep '^PERSONALITY=' "$meta" | cut -d= -f2)"
        case "$p" in
            app-xpra)         printf 'Application' ;;
            app)              printf 'Application' ;;
            apps-compatible)  printf 'Compatibility' ;;
            vault-postgres)   printf 'Database Vault' ;;
            vault-files)      printf 'File Vault' ;;
            *)                printf '%s' "$p" ;;
        esac
        return
    done
    printf 'Unknown'
}

# state_of - one of: running, stopped, unlocked, locked.
state_of() {
    name="$1"
    if is_running "$name"; then
        printf 'running'; return
    fi
    if is_vault "$name"; then
        ds="zroot/vault-data/$name"
        ks="$(zfs get -H -o value keystatus "$ds" 2>/dev/null || echo unknown)"
        if [ "$ks" = "available" ]; then
            printf 'unlocked'
        else
            printf 'locked'
        fi
        return
    fi
    printf 'stopped'
}

# symbol_state - pretty form for the list.
symbol_state() {
    case "$1" in
        running)  printf '● Running' ;;
        unlocked) printf '● Unlocked' ;;
        stopped)  printf '○ Stopped' ;;
        locked)   printf '🔒 Locked' ;;
        *)        printf '%s' "$1" ;;
    esac
}

# =====================================================================
# Main window - small, clean, few buttons
# =====================================================================

main_window() {
    while :; do
        set -- yad --list
        set -- "$@" --column="Name" --column="Kind" --column="State"

        any=0
        while IFS='|' read -r name kind state; do
            [ -n "$name" ] || continue
            set -- "$@" "$name" "$(kind_of "$name")" "$(symbol_state "$(state_of "$name")")"
            any=1
        done <<EOF
$(get_containers)
EOF

        if [ "$any" -eq 0 ]; then
            rc=0
            yad --info --window-icon="$LOGO" \
                --title="ParishBSD Container Manager" \
                --text="<b>No containers yet.</b>\n\nContainers isolate applications and data.\nCreate one to get started." \
                --width=460 --height=240 \
                --button="Create:10" \
                --button="Close:0" || rc=$?
            case "$rc" in
                10) cmd_create ;;
                *)  exit 0 ;;
            esac
            continue
        fi

        set -- "$@" \
            --title="ParishBSD Container Manager" \
            --window-icon="$LOGO" \
            --text="<b>Containers</b>\nSelect a container, then click Actions." \
            --width=720 --height=460 \
            --no-headers \
            --search-column=1 \
            --print-column=1 \
            --resizable \
            --button="Actions:10" \
            --button="Create New:20" \
            --button="Refresh:30" \
            --button="Close:0"

        rc=0
        choice="$("$@")" || rc=$?
        choice="$(printf '%s' "$choice" | tr -d '\n\r' | sed 's/[[:space:]]*$//')"

        case "$rc" in
            0)  exit 0 ;;
            10) [ -n "$choice" ] && actions_dialog "$choice" ;;
            20) cmd_create ;;
            30) continue ;;
        esac
    done
}

# =====================================================================
# Actions dialog - everything for one container
# =====================================================================

actions_dialog() {
    name="$1"
    kind="$(kind_of "$name")"
    state="$(state_of "$name")"

    # The text shown at the top of the dialog.
    case "$state" in
        running)  state_text="Running" ;;
        stopped)  state_text="Stopped" ;;
        unlocked) state_text="Unlocked (running)" ;;
        locked)   state_text="Locked" ;;
    esac

    info_text="<b>$name</b>\n\nKind: $kind\nState: $state_text"

    set -- yad --text="$info_text"
    set -- "$@" --title="Actions: $name"
    set -- "$@" --window-icon="$LOGO"
    set -- "$@" --width=440 --height=340
    set -- "$@" --image="$LOGO" --image-on-top
    set -- "$@" --wrap

    if is_vault "$name"; then
        # Vault actions.
        if [ "$state" = "locked" ]; then
            set -- "$@" --button="Unlock:10"
        else
            set -- "$@" --button="Open Files:11"
            set -- "$@" --button="Lock:12"
        fi
    elif is_running "$name"; then
        # Running app - most actions available.
        set -- "$@" --button="Open:20"
        set -- "$@" --button="Console:21"
        set -- "$@" --button="Install App:22"
        set -- "$@" --button="Attach Device:23"
        set -- "$@" --button="Stop:24"
    else
        # Stopped app - start it.
        set -- "$@" --button="Start:25"
        set -- "$@" --button="Install App:22"
    fi

    set -- "$@" --button="Destroy:30"
    set -- "$@" --button="Close:0"

    rc=0
    "$@" || rc=$?

    case "$rc" in
        0)  return ;;
        10) cmd_unlock "$name" ;;
        11) cmd_open_files "$name" ;;
        12) cmd_lock "$name" ;;
        20) cmd_open "$name" ;;
        21) cmd_console "$name" ;;
        22) cmd_install_app "$name" ;;
        23) cmd_attach_device "$name" ;;
        24) cmd_stop "$name" ;;
        25) cmd_start "$name" ;;
        30) cmd_destroy "$name" ;;
    esac
}

# =====================================================================
# Container operations
# =====================================================================

cmd_start() {
    name="$1"
    if is_running "$name"; then
        yad --info --window-icon="$LOGO" \
            --text="'$name' is already running." --button="OK:0"
        return
    fi

    if is_vault "$name"; then
        cmd_unlock "$name"
        return
    fi

    if "$PARISHCTL" start "$name" >/dev/null 2>&1; then
        yad --info --window-icon="$LOGO" \
            --text="Container '$name' started." --button="OK:0"
    else
        yad --error --window-icon="$LOGO" \
            --text="Failed to start '$name'.\nSee /var/log/messages for details." \
            --button="OK:0"
    fi
}

cmd_stop() {
    name="$1"
    yad --question --window-icon="$LOGO" \
        --title="Stop Container" \
        --text="Stop '$name'?\n\nAny unsaved work will be lost." \
        --button="Stop:0" --button="Cancel:1" || return

    if "$PARISHCTL" stop "$name" >/dev/null 2>&1; then
        yad --info --window-icon="$LOGO" \
            --text="Container '$name' stopped." --button="OK:0"
    else
        yad --error --window-icon="$LOGO" \
            --text="Failed to stop '$name'." --button="OK:0"
    fi
}

cmd_unlock() {
    name="$1"
    if is_running "$name"; then
        yad --info --window-icon="$LOGO" \
            --text="Vault '$name' is already unlocked." --button="OK:0"
        return
    fi

    # parishctl reads the passphrase from the TTY. Open a terminal.
    xfce4-terminal --title="Unlock Vault: $name" \
        --geometry=90x20 \
        -e "sh -c '$PARISHCTL unlock $name; printf \"\nPress Enter to close...\"; read _'" &
    sleep 2
}

cmd_lock() {
    name="$1"
    yad --question --window-icon="$LOGO" \
        --title="Lock Vault" \
        --text="Lock vault '$name'?\n\nThe container will stop and its\nencryption key will be unloaded." \
        --button="Lock:0" --button="Cancel:1" || return

    if "$PARISHCTL" lock "$name" >/dev/null 2>&1; then
        yad --info --window-icon="$LOGO" \
            --text="Vault '$name' locked." --button="OK:0"
    else
        yad --error --window-icon="$LOGO" \
            --text="Failed to lock '$name'." --button="OK:0"
    fi
}

cmd_console() {
    name="$1"
    if ! is_running "$name"; then
        yad --error --window-icon="$LOGO" \
            --text="'$name' is not running. Start it first." --button="OK:0"
        return
    fi
    xfce4-terminal --title="Console: $name" \
        -e "sh -c 'jexec $name /bin/sh; printf \"\nPress Enter to close...\"; read _'" &
}

cmd_open() {
    name="$1"
    if ! is_running "$name"; then
        yad --error --window-icon="$LOGO" \
            --text="'$name' is not running." --button="OK:0"
        return
    fi
    cmd_console "$name"
}

cmd_open_files() {
    name="$1"
    if [ -x "$VAULT_FILES" ]; then
        "$VAULT_FILES" "$name" &
    else
        yad --error --window-icon="$LOGO" \
            --text="parish-vault-files not found." --button="OK:0"
    fi
}

cmd_create() {
    # Gather personalities.
    personalities=""
    for d in "$PARISHBSD_ROOT"/personalities/*/; do
        [ -d "$d" ] || continue
        personalities="$personalities$(basename "$d")!"
    done

    [ -n "$personalities" ] || {
        yad --error --window-icon="$LOGO" \
            --text="No personalities found." --button="OK:0"
        return
    }

    # yad --form with a combo box for the personality.
    result="$(yad --form --window-icon="$LOGO" \
        --title="Create Container" \
        --text="<b>Create a new container.</b>\n\nThe personality decides what it can do." \
        --field="Name" \
        --field="Personality:CB" \
        --separator="|" \
        --width=480 \
        --button="Create:10" --button="Cancel:1" \
        "$(printf '%s' "$personalities" | sed 's/!$//;s/!/\n/g')" 2>/dev/null)" || return

    name="$(printf '%s' "$result" | cut -d'|' -f1)"
    personality="$(printf '%s' "$result" | cut -d'|' -f2)"

    [ -n "$name" ] && [ -n "$personality" ] || return

    case "$name" in
        *[!a-zA-Z0-9_-]*)
            yad --error --window-icon="$LOGO" \
                --text="Name may contain only letters, digits, '-' and '_'." \
                --button="OK:0"
            return
            ;;
    esac

    yad --question --window-icon="$LOGO" \
        --text="Create '$name' from '$personality'?" \
        --button="Create:0" --button="Cancel:1" || return

    case "$personality" in
        vault-*)
            # Vault creation prompts for a passphrase - run in a terminal.
            xfce4-terminal --title="Create Vault: $name" \
                --geometry=90x24 \
                -e "sh -c '$PARISHCTL create $name $personality; printf \"\nDone. Press Enter to close...\"; read _'" &
            sleep 2
            ;;
        *)
            if "$PARISHCTL" create "$name" "$personality" >/tmp/.parish-create.log 2>&1; then
                yad --info --window-icon="$LOGO" \
                    --text="Container '$name' created and started." --button="OK:0"
            else
                yad --error --window-icon="$LOGO" \
                    --text="Failed to create '$name'.\n\n$(tail -5 /tmp/.parish-create.log)" \
                    --button="OK:0"
            fi
            rm -f /tmp/.parish-create.log
            ;;
    esac
}

cmd_destroy() {
    name="$1"
    if is_vault "$name"; then
        yad --question --window-icon="$LOGO" \
            --title="Destroy Vault" \
            --text="<b>Destroy vault '$name'?</b>\n\nThe container AND its encrypted data will be\ndestroyed. The data cannot be recovered,\neven with the passphrase." \
            --button="Destroy:0" --button="Cancel:1" || return
    else
        yad --question --window-icon="$LOGO" \
            --title="Destroy Container" \
            --text="Destroy container '$name'?\n\nThis cannot be undone." \
            --button="Destroy:0" --button="Cancel:1" || return
    fi

    xfce4-terminal --title="Destroy: $name" \
        --geometry=90x24 \
        -e "sh -c '$PARISHCTL destroy $name; printf \"\nDone. Press Enter to close...\"; read _'" &
    sleep 2
}

# =====================================================================
# Install Application - Catalog + Custom Installer
# =====================================================================

load_catalog() {
    [ -f "$CATALOG" ] || return 0
    grep -v '^[[:space:]]*#' "$CATALOG" | grep -v '^[[:space:]]*$'
}

cmd_install_app() {
    jail="$1"

    if ! is_running "$jail"; then
        yad --error --window-icon="$LOGO" \
            --text="'$jail' must be running to install applications." \
            --button="OK:0"
        return
    fi

    catalog="$(load_catalog)"

    # Build rows for the list: Name|Category|Description
    set -- yad --list
    set -- "$@" --column="Application" --column="Category" --column="Description"

    any=0
    while IFS='|' read -r cat app pkg desc sugg; do
        [ -n "$app" ] || continue
        set -- "$@" "$app" "$cat" "$desc"
        any=1
    done <<EOF
$catalog
EOF

    if [ "$any" -eq 0 ]; then
        yad --info --window-icon="$LOGO" \
            --text="No catalog entries found.\n\nUse Custom Installer to install\nan application manually." \
            --width=420 --height=220 \
            --button="Custom Installer:20" --button="Close:0" || return
        rc=$?
        case "$rc" in
            20) cmd_install_custom_into "$jail" ;;
        esac
        return
    fi

    set -- "$@" \
        --title="Install Application" \
        --window-icon="$LOGO" \
        --text="<b>Install into: $jail</b>\n\nPick an application from the catalog,\nor use Custom Installer." \
        --width=780 --height=500 \
        --no-headers \
        --search-column=1 \
        --print-column=1 \
        --resizable \
        --button="Install:10" \
        --button="Custom Installer:20" \
        --button="Cancel:0"

    rc=0
    choice="$("$@")" || rc=$?
    choice="$(printf '%s' "$choice" | tr -d '\n\r' | sed 's/[[:space:]]*$//')"

    case "$rc" in
        0)  return ;;
        10)
            [ -n "$choice" ] || return
            pkg="$(printf '%s\n' "$catalog" | awk -F'|' -v app="$choice" '$2 == app {print $3; exit}')"
            [ -n "$pkg" ] || {
                yad --error --window-icon="$LOGO" \
                    --text="Could not find package for '$choice'." --button="OK:0"
                return
            }

            yad --question --window-icon="$LOGO" \
                --text="Install '$choice' ($pkg)\nin container '$jail'?" \
                --button="Install:0" --button="Cancel:1" || return

            xfce4-terminal --title="Install: $choice" \
                --geometry=90x24 \
                -e "sh -c 'jexec $jail pkg install -y $pkg; printf \"\nDone. Press Enter to close...\"; read _'" &
            sleep 2
            ;;
        20)
            cmd_install_custom_into "$jail"
            ;;
    esac
}

cmd_install_custom_into() {
    jail="$1"

    if ! is_compatibility_jail "$jail"; then
        yad --question --window-icon="$LOGO" \
            --title="Not a Compatibility Container" \
            --text="<b>'$jail' is not a compatibility container.</b>\n\nWindows and Linux installers normally\nrequire a container built from the\n'apps-compatible' personality.\n\nContinue anyway?" \
            --button="Continue:0" --button="Cancel:1" || return
    fi

    installer="$(yad --file-selection \
        --title="Select Installer" \
        --window-icon="$LOGO" \
        --file-filter="Installers | *.exe *.msi *.run *.bin *.sh" \
        --file-filter="All files | *")" || return

    [ -f "$installer" ] || return

    yad --question --window-icon="$LOGO" \
        --text="Install:\n  $(basename "$installer")\n\nInto container:\n  $jail\n\nFollow the installer's instructions in the\nterminal window." \
        --button="Install:0" --button="Cancel:1" || return

    if [ -x "$INSTALL_CUSTOM" ]; then
        xfce4-terminal --title="Install: $(basename "$installer")" \
            --geometry=100x28 \
            -e "sh -c '$INSTALL_CUSTOM $jail \"$installer\"; printf \"\nDone. Press Enter to close...\"; read _'" &
        sleep 2
    else
        yad --error --window-icon="$LOGO" \
            --text="parish-install-custom not found." --button="OK:0"
    fi
}

# =====================================================================
# Attach Device
# =====================================================================

cmd_attach_device() {
    jail="$1"

    if ! is_running "$jail"; then
        yad --error --window-icon="$LOGO" \
            --text="'$jail' must be running to attach a device." \
            --button="OK:0"
        return
    fi

    # Enumerate whole-disk block devices. Skip partitions.
    set -- yad --list
    set -- "$@" --column="Device"
    any=0
    for dev in /dev/da[0-9]* /dev/cd[0-9]*; do
        [ -b "$dev" ] || continue
        base="$(basename "$dev")"
        case "$base" in
            da[0-9]*) ;;
            cd[0-9]*) ;;
            *) continue ;;
        esac
        set -- "$@" "$base"
        any=1
    done

    if [ "$any" -eq 0 ]; then
        yad --info --window-icon="$LOGO" \
            --text="No removable devices detected.\n\nPlug in a USB drive or insert a disc,\nthen try again." \
            --button="OK:0"
        return
    fi

    set -- "$@" \
        --title="Attach Device" \
        --window-icon="$LOGO" \
        --text="Attach a device to '$jail'.\nIt will be mounted read-only." \
        --width=380 --height=300 \
        --no-headers \
        --print-column=1 \
        --button="Attach:10" --button="Cancel:0"

    rc=0
    dev="$("$@")" || rc=$?
    dev="$(printf '%s' "$dev" | tr -d '\n\r')"

    case "$rc" in
        0)  return ;;
        10)
            [ -n "$dev" ] || return
            yad --question --window-icon="$LOGO" \
                --text="Attach /dev/$dev to '$jail'?" \
                --button="Attach:0" --button="Cancel:1" || return

            if [ -x "$ATTACH_DEVICE" ]; then
                if "$ATTACH_DEVICE" "$jail" "$dev" >/tmp/.parish-attach.log 2>&1; then
                    yad --info --window-icon="$LOGO" \
                        --text="Attached /dev/$dev to '$jail'.\nAvailable at /media/$dev inside the container." \
                        --button="OK:0"
                else
                    yad --error --window-icon="$LOGO" \
                        --text="Failed to attach /dev/$dev.\n\n$(tail -3 /tmp/.parish-attach.log)" \
                        --button="OK:0"
                fi
                rm -f /tmp/.parish-attach.log
            else
                yad --error --window-icon="$LOGO" \
                    --text="parish-attach-device not found." --button="OK:0"
            fi
            ;;
    esac
}

# =====================================================================
# Entry point
# =====================================================================

main_window
