#!/bin/sh
# parish-xpra-attach  attach the host's Xpra client to a jail's server.
set -eu

jail="$1"
display="${2:-:100}"

[ -n "$jail" ] || { echo "usage: $0 <jail> [display]" >&2; exit 1; }

disp_num="${display#:}"
socket="/var/run/xpra/$jail/$disp_num/socket"
[ -S "$socket" ] || { echo "no Xpra socket at $socket" >&2; exit 1; }

# Colored window border by trust tier (matches Qubes's visual language).
personality="$(awk -F= '/^PERSONALITY=/{print $2}' \
    /usr/local/jails/app/$jail/usr/local/etc/parishbsd/metadata 2>/dev/null || echo '')"
case "$personality" in
    vault-*)         colour="#d4af37" ;;   # gold — vault
    apps-compatible) colour="#8b5cf6" ;;   # purple — compatibility
    *)               colour="#3b82f6" ;;   # blue — regular app
esac

exec xpra attach "socket://$socket" \
    --window-border="$colour" \
    --title="$jail"