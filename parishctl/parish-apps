#!/bin/sh
# parish-apps  manage applications in a jail.
#
# Usage:
#   parish-apps list <jail>
#   parish-apps install <jail> <package>
#   parish-apps install-file <jail> <file> [--mode=auto|installer|portable]
#                                            [--launcher=menu|desktop|both|none]
#   parish-apps remove <jail> <package>
#   parish-apps remove-custom <jail> <app-name>
#   parish-apps upgrade <jail> [package]
#   parish-apps set-launcher <jail> <app-name> <command>
#   parish-apps launch <jail> <app-name>
#   parish-apps create-launcher <jail> <name> [menu|desktop|both]
#   parish-apps pkg-launcher <jail> <package> [menu|desktop|both]

set -eu

JAILS_DIR="/usr/local/jails"
EXCHANGE_ROOT="/var/parishbsd/exchange"
BIN_DIR="/usr/local/parishbsd/parishctl"

log() { printf ' %s\n' "$*"; }
err() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# H1
validate_jail_name() {
    [ -n "$1" ] || err "jail name required"
    printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' \
        || err "invalid jail name: '$1'"
}

require_jail() {
    validate_jail_name "$1"
    jls name 2>/dev/null | grep -qx "$1" || err "jail '$1' is not running"
}

# H2
validate_package_name() {
    printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9._+-]+$' \
        || err "invalid package name: '$1'"
}

# H3
canonical_path() {
    local path="$1" real
    real=$(realpath "$path" 2>/dev/null) || err "cannot resolve: $path"
    [ "$real" = "$path" ] || err "not canonical: $path -> $real"
    echo "$real"
}

# H4
safe_meta_filename() {
    printf '%s' "$1" | tr ' /' '__' | sed 's/[^A-Za-z0-9._-]//g'
}

escape_quotes() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# =====================================================================
# Metadata  the .conf format that parish-app-launch and the GUI read
# =====================================================================

write_metadata() {
    jail="$1" app="$2" version="$3" method="$4" install_path="$5" launcher_cmd="$6" icon="${7:-parish-container-app}"
    validate_jail_name "$jail"
    meta_dir="$JAILS_DIR/app/$jail/usr/local/etc/parishbsd/custom-apps"
    mkdir -p "$meta_dir"
    safe="$(safe_meta_filename "$app")"
    meta_file="$meta_dir/$safe.conf"
    tmp="${meta_file}.tmp.$$"
    {
        printf 'NAME="%s"\n'       "$(escape_quotes "$app")"
        printf 'VERSION="%s"\n'    "$(escape_quotes "$version")"
        printf 'INSTALL_METHOD="%s"\n' "$(escape_quotes "$method")"
        printf 'INSTALL_PATH="%s"\n'   "$(escape_quotes "$install_path")"
        printf 'LAUNCHER_COMMAND="%s"\n' "$(escape_quotes "$launcher_cmd")"
        printf 'ICON_NAME="%s"\n'  "$(escape_quotes "$icon")"
    } > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$meta_file"
}

read_metadata_field() {
    file="$1"
    key="$2"
    awk -F= -v k="$key" '$1==k { v=$0; sub(/^[^=]*=/,"",v); gsub(/^"|"$/,"",v); print v; exit }' "$file"
}

# =====================================================================
# list
# =====================================================================

cmd_list() {
    jail="${1:?usage: parish-apps list <jail>}"
    require_jail "$jail"

    # Native packages
    pkg -j "$jail" info 2>/dev/null | awk '{
        name = $1
        sub(/-[0-9].*$/, "", name)
        version = $1
        sub(/^.*-/, "", version)
        $1 = ""
        printf "native\t%s\t%s\t%s\n", name, version, $0
    }'

    # Custom apps
    meta_dir="$JAILS_DIR/app/$jail/usr/local/etc/parishbsd/custom-apps"
    if [ -d "$meta_dir" ]; then
        for f in "$meta_dir"/*.conf; do
            [ -f "$f" ] || continue
            name="$(read_metadata_field "$f" NAME)"
            version="$(read_metadata_field "$f" VERSION)"
            method="$(read_metadata_field "$f" INSTALL_METHOD)"
            printf "custom\t%s\t%s\t%s\n" "${name:-?}" "${version:-?}" "${method:-?}"
        done
    fi
}

# =====================================================================
# install (from catalog)
# =====================================================================

cmd_install() {
    jail="${1:?usage: parish-apps install <jail> <package>}"
    package="${2:?usage: parish-apps install <jail> <package>}"
    require_jail "$jail"
    validate_package_name "$package"
    log "Installing $package in $jail"
    pkg -j "$jail" install -y "$package"
}

# =====================================================================
# install-file
# =====================================================================

cmd_install_file() {
    jail="${1:?usage: parish-apps install-file <jail> <file> [flags]}"
    shift
    host_file="${1:?usage: parish-apps install-file <jail> <file> [flags]}"
    shift || true
    require_jail "$jail"
    # H3: file must be canonical and not a symlink
    [ -f "$host_file" ] || err "not a regular file: $host_file"
    [ ! -L "$host_file" ] || err "file is a symlink: $host_file"
    canonical_path "$host_file" >/dev/null

    mode="auto"
    launcher="none"
    for arg in "$@"; do
        case "$arg" in
            --mode=installer)   mode="installer" ;;
            --mode=portable)    mode="portable" ;;
            --mode=auto)        mode="auto" ;;
            --launcher=menu)    launcher="menu" ;;
            --launcher=desktop) launcher="desktop" ;;
            --launcher=both)    launcher="both" ;;
            --launcher=none)    launcher="none" ;;
        esac
    done

    require_jail "$jail"
    [ -f "$host_file" ] || err "file not found: $host_file"

    detected="$("$BIN_DIR/parish-detect-installer" "$host_file")"
    type_key="${detected%%:*}"
    log "Detected: $detected"

    # Resolve ambiguous types via --mode.
    case "$type_key" in
        windows-exe-ambiguous)
            [ "$mode" = "portable" ]  && type_key="windows-portable-archive"
            [ "$mode" = "installer" ] && type_key="windows-installer"
            ;;
        linux-run-ambiguous)
            [ "$mode" = "portable" ]  && type_key="linux-portable-archive"
            [ "$mode" = "installer" ] && type_key="linux-installer"
            ;;
    esac

    app_name=""
    case "$type_key" in
        freebsd-pkg)              app_name="$(do_freebsd_pkg     "$jail" "$host_file")" ;;
        windows-installer)        app_name="$(do_win_installer   "$jail" "$host_file")" ;;
        windows-portable-archive) app_name="$(do_win_portable    "$jail" "$host_file")" ;;
        linux-portable-archive)   app_name="$(do_linux_portable  "$jail" "$host_file")" ;;
        linux-installer)          app_name="$(do_linux_installer "$jail" "$host_file")" ;;
        unsupported-*)            err "unsupported file type: $detected" ;;
        *)                        err "cannot install this file type: $detected" ;;
    esac

    if [ -n "$app_name" ] && [ "$launcher" != "none" ]; then
        log "Creating launcher for '$app_name' ($launcher)"
        "$BIN_DIR/parish-app-create-launcher" "$jail" "$app_name" "$launcher" \
            || log "WARN: launcher creation failed"
    fi

    log "Done"
}

# =====================================================================
# Exchange helpers
# =====================================================================

copy_to_exchange() {
    jail="$1"; file="$2"
    base="$(basename "$file")"
    dest_dir="$(exchange_dir "$jail")"
    mkdir -p "$dest_dir"
    cp -a "$file" "$dest_dir/$base"
    chmod 0644 "$dest_dir/$base"
    printf '%s' "$base"
}

cleanup_exchange() {
    jail="$1"; base="$2"
    [ -n "$base" ] || return 0
    rm -f "$(exchange_dir "$jail")/$base" 2>/dev/null || true
}

# =====================================================================
# Install handlers
# =====================================================================

do_freebsd_pkg() {
    jail="$1"; host_file="$2"
    base="$(copy_to_exchange "$jail" "$host_file")"
    trap "cleanup_exchange '$jail' '$base'" EXIT INT TERM

    log "Installing FreeBSD package $base"
    jexec "$jail" pkg add "/exchange/$base"

    # Determine installed package name (last package in pkg's db, or from filename).
    pkg_name="$(jexec "$jail" pkg info -a -o 2>/dev/null | tail -1 | sed 's|.*/||')"
    [ -n "$pkg_name" ] || pkg_name="$(echo "$base" | sed 's/-[0-9].*//')"

    # Look for a matching .desktop inside the jail to find the exec.
    launcher="$pkg_name"
    for d in /usr/local/share/applications /usr/share/applications; do
        cand="$d/$pkg_name.desktop"
        if jexec "$jail" test -f "$cand" 2>/dev/null; then
            exec_line="$(jexec "$jail" sh -c \
                "grep '^Exec=' '$cand' | head -1 | cut -d= -f2-")"
            [ -n "$exec_line" ] && launcher="$exec_line"
            break
        fi
    done

    ver="$(jexec "$jail" pkg query %v "$pkg_name" 2>/dev/null || echo 1.0)"

    result="$(write_metadata "$jail" "$pkg_name" "$ver" \
        "freebsd-pkg" "/usr/local" "$launcher")"

    cleanup_exchange "$jail" "$base"
    trap - EXIT INT TERM
    log "Package installed"
    printf '%s' "$result"
}

do_win_installer() {
    jail="$1"; host_file="$2"
    base="$(copy_to_exchange "$jail" "$host_file")"
    trap "cleanup_exchange '$jail' '$base'" EXIT INT TERM

    log "Running Windows installer $base (Wine)"
    jexec "$jail" wine "/exchange/$base"

    # Find the newest .exe outside wine's system directories.
    exe="$(jexec "$jail" sh -c "
        find /root/.wine/drive_c -name '*.exe' -type f \
            -not -path '*windows*' 2>/dev/null \
            | xargs ls -t 2>/dev/null | head -1
    ")"
    stem="$(echo "$base" | sed 's/\.[^.]*$//; s/-[Ss]etup$//; s/[Ss]etup$//')"

    cleanup_exchange "$jail" "$base"
    trap - EXIT INT TERM

    if [ -z "$exe" ]; then
        log "WARN: no .exe found after installer; metadata not written"
        log "You can still launch the app from a console."
        return 0
    fi

    result="$(write_metadata "$jail" "$stem" "1.0" \
        "wine-installer" "$(dirname "$exe")" "wine $exe" "wine")"
    log "Installer finished; main program at $exe"
    printf '%s' "$result"
}

do_win_portable() {
    jail="$1"; host_file="$2"
    base="$(copy_to_exchange "$jail" "$host_file")"
    trap "cleanup_exchange '$jail' '$base'" EXIT INT TERM

    stem="$(printf '%s' "$base" | sed 's/\.[^.]*$//')"
    install_dir="/opt/parish-apps/$stem"

    log "Extracting to $install_dir inside $jail"

    jexec "$jail" sh -c "
        set -eu
        mkdir -p '$install_dir'
        cd '$install_dir'
        case '$base' in
            *.zip)           unzip -q /exchange/'$base' ;;
            *.tar.gz|*.tgz)  tar -xzf /exchange/'$base' ;;
            *.tar.xz)        tar -xJf /exchange/'$base' ;;
            *.tar.bz2)       tar -xjf /exchange/'$base' ;;
            *) echo 'unsupported archive'; exit 1 ;;
        esac
    "

    exe="$(jexec "$jail" find "$install_dir" -maxdepth 3 -name '*.exe' \
            -type f 2>/dev/null | head -1)"

    if [ -n "$exe" ]; then
        launcher="wine $exe"
    else
        launcher="wine $install_dir"
    fi

    result="$(write_metadata "$jail" "$stem" "1.0" \
        "wine-portable" "$install_dir" "$launcher" "wine")"

    cleanup_exchange "$jail" "$base"
    trap - EXIT INT TERM
    log "Portable application installed at $install_dir"
    printf '%s' "$result"
}

do_linux_portable() {
    jail="$1"; host_file="$2"
    base="$(copy_to_exchange "$jail" "$host_file")"
    trap "cleanup_exchange '$jail' '$base'" EXIT INT TERM

    stem="$(printf '%s' "$base" | sed 's/\.[^.]*$//')"
    install_dir="/opt/parish-apps/$stem"

    log "Extracting to $install_dir inside $jail"

    jexec "$jail" sh -c "
        set -eu
        mkdir -p '$install_dir'
        cd '$install_dir'
        case '$base' in
            *.zip)           unzip -q /exchange/'$base' ;;
            *.tar.gz|*.tgz)  tar -xzf /exchange/'$base' ;;
            *.tar.xz)        tar -xJf /exchange/'$base' ;;
            *.tar.bz2)       tar -xjf /exchange/'$base' ;;
            *) echo 'unsupported archive'; exit 1 ;;
        esac
        chmod +x bin/* usr/bin/* 2>/dev/null || true
    "

    binary="$(jexec "$jail" sh -c "
        for candidate in '$install_dir/$stem' '$install_dir/bin/$stem' \
                          '$install_dir/usr/bin/$stem'; do
            [ -x \"\$candidate\" ] && echo \"\$candidate\" && exit 0
        done
        [ -d '$install_dir/bin' ] && \
            find '$install_dir/bin' -maxdepth 1 -type f -perm -u+x | head -1
    ")"

    if [ -z "$binary" ]; then
        launcher="sh -c 'cd $install_dir; ./run.sh 2>/dev/null || ./$stem'"
    else
        launcher="$binary"
    fi

    result="$(write_metadata "$jail" "$stem" "1.0" \
        "linux-portable" "$install_dir" "$launcher" "parish-container-compat")"

    cleanup_exchange "$jail" "$base"
    trap - EXIT INT TERM
    log "Portable application installed at $install_dir"
    printf '%s' "$result"
}

do_linux_installer() {
    jail="$1"; host_file="$2"
    base="$(copy_to_exchange "$jail" "$host_file")"
    trap "cleanup_exchange '$jail' '$base'" EXIT INT TERM

    log "Running Linux installer $base"

    # .run/.bin may be ELF or shell. Try direct execution first,
    # fall back to sh if the file is a script.
    if ! jexec "$jail" sh -c "[ -x /exchange/'$base' ] && /exchange/'$base'"; then
        jexec "$jail" /compat/linux/bin/sh "/exchange/$base"
    fi

    stem="$(echo "$base" | sed 's/\.[^.]*$//; s/-[Ii]nstall.*//')"

    # Linux installers typically put things under /opt/<name> or /usr/local/<name>.
    install_dir="/opt/$stem"
    jexec "$jail" test -d "/opt/$stem" || install_dir="/usr/local/$stem"
    jexec "$jail" test -d "$install_dir" || install_dir=""

    if [ -n "$install_dir" ]; then
        result="$(write_metadata "$jail" "$stem" "1.0" \
            "linux-installer" "$install_dir" "$stem" "parish-container-compat")"
    else
        log "WARN: could not locate install directory for $stem"
        result=""
    fi

    cleanup_exchange "$jail" "$base"
    trap - EXIT INT TERM
    log "Installer finished"
    printf '%s' "$result"
}

# =====================================================================
# remove / remove-custom / upgrade
# =====================================================================

cmd_remove() {
    jail="${1:?usage: parish-apps remove <jail> <package>}"
    package="${2:?usage: parish-apps remove <jail> <package>}"
    require_jail "$jail"

    case "$package" in
        *[!A-Za-z0-9._+-]*) err "invalid package name: $package" ;;
    esac

    log "Removing $package from $jail"
    pkg -j "$jail" delete -y "$package"
}

cmd_remove_custom() {
    jail="${1:?usage: parish-apps remove-custom <jail> <app-name>}"
    app_name="${2:?usage: parish-apps remove-custom <jail> <app-name>}"

    meta_dir="$JAILS_DIR/app/$jail/usr/local/etc/parishbsd/custom-apps"
    [ -d "$meta_dir" ] || err "no custom-apps directory in '$jail'"

    found=0
    for f in "$meta_dir"/*.conf; do
        [ -f "$f" ] || continue
        name="$(read_metadata_field "$f" NAME)"
        if [ "$name" = "$app_name" ]; then
            rm -f "$f"
            log "Removed metadata for $app_name"
            found=1
            break
        fi
    done
    [ "$found" -eq 1 ] || err "no metadata found for '$app_name'"
    log "Note: installed files under /opt/parish-apps/ were not removed."
}

cmd_upgrade() {
    jail="${1:?usage: parish-apps upgrade <jail> [package]}"
    package="${2:-}"
    require_jail "$jail"

    if [ -n "$package" ]; then
        case "$package" in
            *[!A-Za-z0-9._+-]*) err "invalid package name: $package" ;;
        esac
        log "Upgrading $package in $jail"
        pkg -j "$jail" upgrade -y "$package"
    else
        log "Upgrading all packages in $jail"
        pkg -j "$jail" upgrade -y
    fi
}

# =====================================================================
# set-launcher / launch / create-launcher / pkg-launcher
# =====================================================================

cmd_set_launcher() {
    jail="${1:?usage: parish-apps set-launcher <jail> <app> <command>}"
    app_name="${2:?usage: parish-apps set-launcher <jail> <app> <command>}"
    command="${3:?usage: parish-apps set-launcher <jail> <app> <command>}"

    meta_dir="$JAILS_DIR/app/$jail/usr/local/etc/parishbsd/custom-apps"
    found=0
    for f in "$meta_dir"/*.conf; do
        [ -f "$f" ] || continue
        name="$(read_metadata_field "$f" NAME)"
        [ "$name" = "$app_name" ] || continue

        tmp="$(mktemp)"
        awk -v cmd="$command" '
            /^LAUNCHER_COMMAND=/ { print "LAUNCHER_COMMAND=\"" cmd "\""; next }
            { print }
        ' "$f" > "$tmp"
        mv "$tmp" "$f"
        chmod 0644 "$f"
        log "Updated launcher command for '$app_name'"
        found=1
        break
    done
    [ "$found" -eq 1 ] || err "no metadata for '$app_name' in '$jail'"
}

cmd_launch() {
    jail="${1:?usage: parish-apps launch <jail> <app>}"
    app="${2:?usage: parish-apps launch <jail> <app>}"
    exec "$BIN_DIR/parish-app-launch" "$jail" "$app"
}

cmd_create_launcher() {
    jail="${1:?usage: parish-apps create-launcher <jail> <name> [where]}"
    name="${2:?}"
    where="${3:-menu}"
    exec "$BIN_DIR/parish-app-create-launcher" "$jail" "$name" "$where"
}

cmd_pkg_launcher() {
    jail="${1:?usage: parish-apps pkg-launcher <jail> <package> [where]}"
    package="${2:?}"
    where="${3:-menu}"
    case "$package" in
        *[!A-Za-z0-9._+-]*) err "invalid package name: $package" ;;
    esac
    exec "$BIN_DIR/parish-app-create-launcher" "$jail" "$package" "$where"
}

# =====================================================================
# Dispatch
# =====================================================================

cmd="${1:-}"; shift || true
case "$cmd" in
    list)            cmd_list            "$@" ;;
    install)         cmd_install         "$@" ;;
    install-file)    cmd_install_file    "$@" ;;
    remove)          cmd_remove          "$@" ;;
    remove-custom)   cmd_remove_custom   "$@" ;;
    upgrade)         cmd_upgrade         "$@" ;;
    set-launcher)    cmd_set_launcher    "$@" ;;
    launch)          cmd_launch          "$@" ;;
    create-launcher) cmd_create_launcher "$@" ;;
    pkg-launcher)    cmd_pkg_launcher    "$@" ;;
    *)
        err "usage: parish-apps {list|install|install-file|remove|remove-custom|upgrade|set-launcher|launch|create-launcher|pkg-launcher} ..."
        ;;
esac