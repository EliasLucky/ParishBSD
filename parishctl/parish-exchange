#!/bin/sh
# parish-exchange  manage file transfer between jails via the exchange.
#
# Usage:
#   parish-exchange list <jail>                    List files in a jail's exchange
#   parish-exchange copy <src-jail> <file> <dst-jail>   Copy a file between jails
#   parish-exchange move <src-jail> <file> <dst-jail>   Move (copy + delete) a file
#   parish-exchange put <host-file> <dst-jail>     Copy a host file into a jail's exchange
#   parish-exchange get <src-jail> <file> <dest>   Copy a jail file out to the host
set -eu

EXCHANGE_ROOT="/var/parishbsd/exchange"

log() { logger -t parish-exchange -p user.info -- "$*" 2>/dev/null || true; }
err() { logger -t parish-exchange -p user.err -- "$*" 2>/dev/null || true; \
        echo "parish-exchange: $*" >&2; exit 1; }
require_root() { [ "$(id -u)" -eq 0 ] || err "must be run as root"; }

validate_name() {
    [ -n "$1" ] || err "empty name"
    printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' \
        || err "invalid name: '$1' (must match [A-Za-z0-9][A-Za-z0-9._-]{0,63})"
}

ensure_exchange_root() {
    [ -d "$EXCHANGE_ROOT" ] || err "exchange root missing: $EXCHANGE_ROOT"
    local real
    real=$(realpath "$EXCHANGE_ROOT") || err "cannot resolve $EXCHANGE_ROOT"
    [ "$real" = "$EXCHANGE_ROOT" ] \
        || err "exchange root not canonical: $real"
}

jail_exchange_dir() {
    local jail="$1"
    validate_name "$jail"
    ensure_exchange_root
    local dir="$EXCHANGE_ROOT/$jail"
    [ -d "$dir" ] || err "exchange dir not found for jail: $jail"
    [ ! -L "$dir" ] || err "exchange dir is a symlink: $dir"
    local real
    real=$(realpath "$dir") || err "cannot resolve $dir"
    [ "$real" = "$dir" ] || err "exchange dir not canonical: $dir -> $real"
    echo "$real"
}

resolve_rel_path() {
    local base="$1" rel="$2" full parent parent_real

    # reject absolute paths
    case "$rel" in
        /*) err "absolute path not allowed: $rel" ;;
    esac

    # reject ".." as a path component (not as a substring of a filename)
    case "/$rel/" in
        */../*) err "path traversal not allowed: $rel" ;;
    esac

    [ -n "$rel" ] || err "empty path"

    full="$base/$rel"
    parent=$(dirname "$full")
    [ -d "$parent" ] || err "parent directory not found: $parent"
    parent_real=$(realpath "$parent") || err "cannot resolve $parent"
    case "$parent_real" in
        "$base"|"$base"/*) ;;
        *) err "path escapes exchange: $full -> $parent_real" ;;
    esac

    if [ -e "$full" ]; then
        [ ! -L "$full" ] || err "target is a symlink: $full"
        local full_real
        full_real=$(realpath "$full") || err "cannot resolve $full"
        case "$full_real" in
            "$base"/*) ;;
            *) err "file escapes exchange: $full -> $full_real" ;;
        esac
        echo "$full_real"
    else
        echo "$full"
    fi
}

require_regular_files() {
    local path="$1"
    if [ -d "$path" ]; then
        if find "$path" ! -type f ! -type d ! -type l -print -quit | grep -q .; then
            err "source contains non-regular files (device/FIFO/socket): $path"
        fi
    elif [ ! -f "$path" ] && [ ! -L "$path" ]; then
        err "source is not a regular file or directory: $path"
    fi
}

# strip setuid/setgid recursively
strip_special_bits() {
    local path="$1"
    if [ -d "$path" ]; then
        find "$path" -type f -perm -4000 -exec chmod u-s {} \; 2>/dev/null || true
        find "$path" -type f -perm -2000 -exec chmod g-s {} \; 2>/dev/null || true
    elif [ -f "$path" ]; then
        chmod ug-s "$path" 2>/dev/null || true
    fi
}

do_copy() {
    local src="$1" dst="$2"
    require_regular_files "$src"
    if [ -d "$src" ]; then
        cp -R "$src" "$dst" || return 1
    else
        cp "$src" "$dst" || return 1
    fi
    strip_special_bits "$dst"
    return 0
}

cmd_list() {
    ensure_exchange_root
    echo "Jails with exchange directories:"
    for dir in "$EXCHANGE_ROOT"/*; do
        [ -d "$dir" ] || continue
        [ -L "$dir" ] && continue
        jail=$(basename "$dir")
        # display-only filter; validate_name would reject anything invalid
        printf '%s\n' "$jail" \
            | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' \
            && echo "  $jail"
    done
}

cmd_copy() {
    [ $# -eq 4 ] || err "usage: parish-exchange copy <srcjail> <srcpath> <dstjail> <dstpath>"
    local srcjail="$1" srcpath="$2" dstjail="$3" dstpath="$4"
    require_root
    local srcbase dstbase src dst
    srcbase=$(jail_exchange_dir "$srcjail")
    dstbase=$(jail_exchange_dir "$dstjail")
    src=$(resolve_rel_path "$srcbase" "$srcpath")
    dst=$(resolve_rel_path "$dstbase" "$dstpath")
    [ -e "$src" ] || err "source not found: $srcpath"
    do_copy "$src" "$dst" || err "copy failed: $srcpath -> $dstpath"
    log "copied $srcjail:$srcpath -> $dstjail:$dstpath"
    echo "Copied: $srcjail:$srcpath -> $dstjail:$dstpath"
}

cmd_move() {
    [ $# -eq 4 ] || err "usage: parish-exchange move <srcjail> <srcpath> <dstjail> <dstpath>"
    local srcjail="$1" srcpath="$2" dstjail="$3" dstpath="$4"
    require_root
    local srcbase dstbase src dst
    srcbase=$(jail_exchange_dir "$srcjail")
    dstbase=$(jail_exchange_dir "$dstjail")
    src=$(resolve_rel_path "$srcbase" "$srcpath")
    dst=$(resolve_rel_path "$dstbase" "$dstpath")
    [ -e "$src" ] || err "source not found: $srcpath"
    # H5: copy first; only unlink source on copy success
    do_copy "$src" "$dst" || err "copy failed, source preserved: $srcpath"
    rm -rf "$src" || err "copy succeeded but source removal failed: $src"
    log "moved $srcjail:$srcpath -> $dstjail:$dstpath"
    echo "Moved: $srcjail:$srcpath -> $dstjail:$dstpath"
}

cmd_put() {
    [ $# -eq 3 ] || err "usage: parish-exchange put <srcfile> <jail> <dstpath>"
    local srcfile="$1" jail="$2" dstpath="$3"
    require_root
    [ -e "$srcfile" ] || err "source not found: $srcfile"
    [ ! -L "$srcfile" ] || err "source is a symlink: $srcfile"
    local dstbase dst
    dstbase=$(jail_exchange_dir "$jail")
    dst=$(resolve_rel_path "$dstbase" "$dstpath")
    do_copy "$srcfile" "$dst" || err "copy failed: $srcfile -> $dstpath"
    log "put $srcfile -> $jail:$dstpath"
    echo "Put: $srcfile -> $jail:$dstpath"
}

cmd_get() {
    [ $# -eq 3 ] || err "usage: parish-exchange get <jail> <srcpath> <dstfile>"
    local jail="$1" srcpath="$2" dstfile="$3"
    require_root
    local srcbase src
    srcbase=$(jail_exchange_dir "$jail")
    src=$(resolve_rel_path "$srcbase" "$srcpath")
    [ -e "$src" ] || err "source not found: $srcpath"
    do_copy "$src" "$dstfile" || err "copy failed: $srcpath -> $dstfile"
    log "got $jail:$srcpath -> $dstfile"
    echo "Got: $jail:$srcpath -> $dstfile"
}

main() {
    [ $# -ge 1 ] || err "usage: parish-exchange {list|copy|move|put|get} ..."
    cmd="$1"; shift
    case "$cmd" in
        list) cmd_list "$@" ;;
        copy) cmd_copy "$@" ;;
        move) cmd_move "$@" ;;
        put)  cmd_put  "$@" ;;
        get)  cmd_get  "$@" ;;
        *)    err "unknown subcommand: $cmd" ;;
    esac
}

main "$@"