#!/bin/sh
# parish-attach-device attach a block device to a jail.
#
# Usage: parish-attach-device <jail> <device>
#
# The device is mounted read-only on the host, then bind-mounted into
# the jail at /media/<device>. The host never allows the jail to write
# directly to the device.
set -eu

jail="$1"
dev="$2"

[ -n "$jail" ] || { echo "usage: $0 <jail> <device>" >&2; exit 1; }
[ -b "/dev/$dev" ] || { echo "block device not found: /dev/$dev" >&2; exit 1; }

# Mount read-only on the host.
host_mnt="/var/parishbsd/media/$dev"
mkdir -p "$host_mnt"

# Detect filesystem type.
fstype="$(fstyp "/dev/$dev" 2>/dev/null || echo msdosfs)"

case "$fstype" in
    msdosfs)  mount -t msdosfs -o ro "/dev/$dev" "$host_mnt" ;;
    ufs)      mount -t ufs -o ro "/dev/$dev" "$host_mnt" ;;
    cd9660)   mount -t cd9660 -o ro "/dev/$dev" "$host_mnt" ;;
    *)        echo "Unsupported filesystem: $fstype" >&2; exit 1 ;;
esac

# Bind-mount into the jail.
jail_mnt="/usr/local/jails/app/$jail/media/$dev"
mkdir -p "$jail_mnt"

mount_nullfs "$host_mnt" "$jail_mnt"

echo "Device /dev/$dev attached to '$jail' at /media/$dev (read-only)."
