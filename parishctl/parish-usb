#!/bin/sh
# parish-usb  attach/detach/list removable media.
set -eu

JAIL_ROOT_APP="/usr/local/jails/app"
JAIL_ROOT_VAULT="/usr/local/jails/vault"
HOST_MNT_ROOT="/var/parishbsd/media"
JAIL_MNT_SUBDIR="media"
ALLOWED_FS="msdosfs ufs cd9660 exfat ntfs"

log() { logger -t parish-usb -p user.info -- "$*" 2>/dev/null || true; }
err() { logger -t parish-usb -p user.err -- "$*" 2>/dev/null || true; \
        echo "parish-usb: $*" >&2; exit 1; }
require_root() { [ "$(id -u)" -eq 0 ] || err "must be run as root"; }

validate_dev() {
    case "$1" in
        da[0-9]*|cd[0-9]*) return 0 ;;
        *) err "invalid device name: '$1' (expected da[0-9]* or cd[0-9]*)" ;;
    esac
}

validate_fs() {
    for fs in $ALLOWED_FS; do
        [ "$1" = "$fs" ] && return 0
    done
    err "unsupported filesystem: '$1' (allowed: $ALLOWED_FS)"
}

# canonical directory, no symlinks, inside expected parent
ensure_dir() {
    local path="$1" parent="$2"
    local parent_real
    parent_real=$(realpath "$parent") || err "cannot resolve parent: $parent"
    [ "$parent_real" = "$parent" ] \
        || err "parent is not canonical: $parent -> $parent_real"
    [ ! -L "$path" ] || err "path is a symlink: $path"
    if [ ! -d "$path" ]; then
        mkdir -p "$path" || err "cannot create $path"
    fi
    [ ! -L "$path" ] || err "path became a symlink: $path"
    case "$path" in
        "$parent"/*) ;;
        *) err "path escapes parent: $path" ;;
    esac
}

validate_jail_name() {
    [ -n "$1" ] || err "empty jail name"
    printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' \
        || err "invalid jail name: '$1'"
}

resolve_jail_root() {
    local jail="$1"
    validate_jail_name "$jail"
    if [ -d "$JAIL_ROOT_APP/$jail" ]; then
        echo "$JAIL_ROOT_APP/$jail"
    elif [ -d "$JAIL_ROOT_VAULT/$jail" ]; then
        echo "$JAIL_ROOT_VAULT/$jail"
    else
        err "jail not found: $jail"
    fi
}

validate_jail_root() {
    local jr="$1" real
    [ ! -L "$jr" ] || err "jail root is a symlink: $jr"
    real=$(realpath "$jr") || err "cannot resolve jail root: $jr"
    [ "$real" = "$jr" ] || err "jail root not canonical: $jr -> $real"
}

is_mounted() {
    mount -p | cut -f2 | grep -qxF "$1"
}

cmd_list() {
    echo "Attached devices:"
    for dir in "$HOST_MNT_ROOT"/*; do
        [ -d "$dir" ] || continue
        [ -L "$dir" ] && continue
        dev=$(basename "$dir")
        if is_mounted "$dir"; then
            jail=$(mount -p | awk -F'\t' -v m="$dir" '$2 == m { print $1; exit }')
            printf "  %-10s  %s\n" "$dev" "$jail"
        else
            printf "  %-10s  %s\n" "$dev" "<not mounted>"
        fi
    done
}

cmd_attach() {
    [ $# -ge 2 ] || err "usage: parish-usb attach <jail> <dev> [fstype]"
    local jail="$1" dev="$2" fstype="${3:-}"
    require_root
    validate_dev "$dev"

    local dev_path="/dev/$dev"
    [ -b "$dev_path" ] || err "not a block device: $dev_path"

    local jail_root
    jail_root=$(resolve_jail_root "$jail")
    validate_jail_root "$jail_root"

    if [ -z "$fstype" ]; then
        fstype=$(fstyp "$dev_path" 2>/dev/null) \
            || err "cannot determine filesystem of $dev_path (specify explicitly)"
    fi
    validate_fs "$fstype"

    # build mount points with canonical + no-symlink checks
    ensure_dir "$HOST_MNT_ROOT" "/var/parishbsd"
    ensure_dir "$HOST_MNT_ROOT/$dev" "$HOST_MNT_ROOT"
    ensure_dir "$jail_root/$JAIL_MNT_SUBDIR" "$jail_root"
    ensure_dir "$jail_root/$JAIL_MNT_SUBDIR/$dev" "$jail_root/$JAIL_MNT_SUBDIR"

    local host_mnt="$HOST_MNT_ROOT/$dev"
    local jail_mnt="$jail_root/$JAIL_MNT_SUBDIR/$dev"

    # mount host side with all security options
    if is_mounted "$host_mnt"; then
        log "host side already mounted: $dev -> $host_mnt"
    else
        mount -t "$fstype" -o ro,nosuid,noexec,nodev "$dev_path" "$host_mnt" \
            || err "cannot mount $dev_path on $host_mnt"
        log "mounted $dev_path -> $host_mnt ($fstype, ro,nosuid,noexec,nodev)"
    fi

    # expose to jail; roll back host mount on failure
    if is_mounted "$jail_mnt"; then
        log "jail side already exposed: $host_mnt -> $jail_mnt"
    else
        if ! mount_nullfs "$host_mnt" "$jail_mnt"; then
            umount "$host_mnt" 2>/dev/null || true
            log "rolled back host mount after jail-mount failure: $host_mnt"
            err "cannot expose $host_mnt inside jail $jail"
        fi
        log "exposed $host_mnt -> $jail_mnt (jail: $jail)"
    fi

    echo "Attached: $dev ($fstype, read-only) -> $jail:/$JAIL_MNT_SUBDIR/$dev"
}

cmd_detach() {
    [ $# -eq 2 ] || err "usage: parish-usb detach <jail> <dev>"
    local jail="$1" dev="$2"
    require_root
    validate_dev "$dev"

    local jail_root
    jail_root=$(resolve_jail_root "$jail")
    validate_jail_root "$jail_root"

    local jail_mnt="$jail_root/$JAIL_MNT_SUBDIR/$dev"
    local host_mnt="$HOST_MNT_ROOT/$dev"

    # unmount jail side first
    if is_mounted "$jail_mnt"; then
        umount "$jail_mnt" \
            || err "cannot unmount $jail_mnt (device busy?)"
        log "unmounted $jail_mnt"
    else
        log "not mounted (jail): $jail_mnt"
    fi

    # then host side
    if is_mounted "$host_mnt"; then
        umount "$host_mnt" \
            || err "cannot unmount $host_mnt (device busy?)"
        log "unmounted $host_mnt"
    else
        log "not mounted (host): $host_mnt"
    fi

    # only rmdir if the mount point is a real directory (not symlink)
    [ -d "$jail_mnt" ] && [ ! -L "$jail_mnt" ] && rmdir "$jail_mnt" 2>/dev/null || true
    [ -d "$host_mnt" ] && [ ! -L "$host_mnt" ] && rmdir "$host_mnt" 2>/dev/null || true

    echo "Detached: $dev from $jail"
}

main() {
    [ $# -ge 1 ] || err "usage: parish-usb {list|attach|detach} ..."
    cmd="$1"; shift
    case "$cmd" in
        list)   cmd_list "$@" ;;
        attach) cmd_attach "$@" ;;
        detach) cmd_detach "$@" ;;
        *)      err "unknown subcommand: $cmd" ;;
    esac
}

main "$@"