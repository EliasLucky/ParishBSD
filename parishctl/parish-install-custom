#!/bin/sh
# parish-install-custom  install a user-supplied application installer.
#
# Usage: parish-install-custom <jail> <installer-file>
#
# The installer is copied into the jail's exchange directory, then
# run inside the jail. .exe and .msi files use wine. .run and .bin
# files use the linux compatibility layer.
set -eu

jail="$1"
installer="$2"
[ -n "$jail" ] || { echo "usage: $0 <jail> <installer>" >&2; exit 1; }

validate_jail_name() {
    printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' \
        || { echo "ERROR: invalid jail name: '$1'" >&2; exit 1; }
}
validate_jail_name "$jail"

[ -f "$installer" ] || { echo "ERROR: installer not found: $installer" >&2; exit 1; }
[ ! -L "$installer" ] || { echo "ERROR: installer is a symlink: $installer" >&2; exit 1; }
real_installer=$(realpath "$installer") || { echo "ERROR: cannot resolve: $installer" >&2; exit 1; }
[ "$real_installer" = "$installer" ] || { echo "ERROR: installer not canonical: $installer -> $real_installer" >&2; exit 1; }

size=$(stat -f%z "$installer")
[ "$size" -le 524288000 ] || { echo "ERROR: installer too large (>500MB)" >&2; exit 1; }

base="$(basename "$installer")"
# sanitize base
base=$(printf '%s' "$base" | sed 's/[^A-Za-z0-9._-]/_/g')
ext="${base##*.}"
case "$ext" in
    exe|msi|run|bin|sh) ;;
    *) echo "ERROR: unsupported installer type: $ext" >&2; exit 1 ;;
esac

# Ensure the jail is running.
if ! jls name 2>/dev/null | grep -qx "$jail"; then
    service jail start "$jail" >/dev/null 2>&1 || exit 1
    sleep 1
fi

fm_root="/usr/local/jails/app/$jail"
exchange_dir="$fm_root/exchange"
[ -d "$exchange_dir" ] || { echo "ERROR: exchange dir missing: $exchange_dir" >&2; exit 1; }
[ ! -L "$exchange_dir" ] || { echo "ERROR: exchange dir is symlink: $exchange_dir" >&2; exit 1; }

dest="$exchange_dir/$base"
# H4
if [ -e "$dest" ]; then
    [ ! -L "$dest" ] || { echo "ERROR: destination is symlink: $dest" >&2; exit 1; }
fi

cp "$installer" "$dest" || { echo "ERROR: copy failed" >&2; exit 1; }
chmod 0600 "$dest"

case "$ext" in
    exe|msi)
        jexec "$jail" wine "/exchange/$base"
        ;;
    run|bin|sh)
        jexec "$jail" /compat/linux/bin/sh "/exchange/$base"
        ;;
esac

echo "Installation complete. The application should now be available"
echo "in the '$jail' container. You may need to create a menu entry"
echo "manually, use the Container Manager to add it."