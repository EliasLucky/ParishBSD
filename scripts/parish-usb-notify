#!/bin/sh
# parish-usb-notify  called by devd on USB storage events.
#
# Writes a single line to a FIFO that the Container Manager reads.
# Does not mount anything; the GUI asks the user which jail to attach.
set -eu

FIFO="/var/run/parishbsd/usb-events"
mkdir -p "$(dirname "$FIFO")" 2>/dev/null || true

case "$1" in
    attach|detach) action="$1" ;;
    *) exit 0 ;;
esac

dev="${2:-}"
case "$dev" in
    da[0-9]*) ;;
    *) exit 0 ;;   # ignore partitions (da0s1), only whole disks
esac

if [ -p "$FIFO" ]; then
    printf '%s %s\n' "$action" "$dev" > "$FIFO" 2>/dev/null || true
fi